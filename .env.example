# Which model the bookstore assistant uses. Default: free local model via Ollama.
EVALLY_PROVIDER=ollama
EVALLY_MODEL=qwen3.5:4b
OLLAMA_URL=http://localhost:11434/v1
# Which model grades the replies (week 5). Set apart from the app's model, so a
# different, ideally stronger, model can judge. Default: the same free local model.
EVALLY_GRADER_PROVIDER=ollama
EVALLY_GRADER_MODEL=qwen3.5:4b
# Only needed if you switch provider to openai or anthropic.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
