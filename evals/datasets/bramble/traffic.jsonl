{"id": "t-clockmaker-stock", "tags": ["topic:stock", "difficulty:medium", "category:cant-find-book-by-title", "source:traffic"], "turns": ["Do you have The Clockmaker's Apprentice in stock?"], "checks": [{"type": "tool_called", "value": "check_stock"}, {"type": "not_contains", "value": "ISBN"}]}
